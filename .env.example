DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
JWT_SECRET=change-me
# Separate secret for the payout admin login. Must differ from the general admin secret.
PAYOUT_ADMIN_SECRET=replace_with_a_private_unique_secret

# PayMongo Hosted Checkout. Keep secret keys on the backend only.
PAYMONGO_SECRET_KEY=sk_test_replace_me
PAYMONGO_WEBHOOK_SECRET=replace_with_this_endpoints_signing_secret
TODAGO_PUBLIC_URL=https://todago-backend-production.up.railway.app

# Existing merchant QR, live webhook only. No live API key is used by this flow.
# Enable only after verifying the actual QR ID in a signed PayMongo notification.
# PAYMONGO_WALLET_QR_MODE=merchant_webhook
PAYMONGO_INSTORE_QR_ID=
PAYMONGO_INSTORE_WEBHOOK_SECRET=
# Operator-requested reset: a unique ID runs once with an audit backup.
# Do not change this ID unless another complete wallet reset is intended.
# WALLET_RESET_REQUEST_ID=

# KYC provider. Use "didit" for Didit-hosted valid ID + face verification.
KYC_PROVIDER=didit

# Didit KYC. Keep these server-side only.
DIDIT_API_KEY=didit_xxxxxxxxxxxxxxxxx
DIDIT_WORKFLOW_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DIDIT_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: completion URL intercepted inside the app; defaults to todago://kyc-complete.
# DIDIT_CALLBACK_URL=todago://kyc-complete
# Optional sandbox testing only.
# DIDIT_SANDBOX_SCENARIO=approve

# Persona KYC. Optional legacy fallback if KYC_PROVIDER=persona.
PERSONA_API_KEY=persona_sandbox_xxxxxxxxxxxxxxxxx
PERSONA_INQUIRY_TEMPLATE_ID=itmpl_xxxxxxxxxxxxxxxxx
PERSONA_ENVIRONMENT_ID=env_xxxxxxxxxxxxxxxxx
PERSONA_WEBHOOK_SECRET=wbhsec_xxxxxxxxxxxxxxxxx
PERSONA_API_VERSION=2023-01-05
